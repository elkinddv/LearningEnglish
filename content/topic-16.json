    { "id": "t16-039", "subtopic": "colocaciones-intensificadoras", "type": "mcq", "prompt": "'a ___ smoker' (alguien que fuma mucho)", "options": ["heavy", "strong", "big"], "answer": "heavy", "explanation": "a heavy smoker / drinker." },
