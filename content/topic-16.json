    { "id": "t16-010", "subtopic": "nominalizacion-formacion", "type": "mcq", "prompt": "'resist' ->", "options": ["resistance", "resistment", "resistion"], "answer": "resistance", "explanation": "Sufijo -ance: resistance." },
    { "id": "t16-011", "subtopic": "nominalizacion-formacion", "type": "mcq", "prompt": "'arrive' ->", "options": ["arrival", "arrivement", "arrivance"], "answer": "arrival", "explanation": "Sufijo -al: arrival." },
    { "id": "t16-012", "subtopic": "nominalizacion-formacion", "type": "mcq", "prompt": "'grow' -> (sustantivo)", "options": ["growth", "growation", "growment"], "answer": "growth", "explanation": "Irregular: growth." },

    { "id": "t16-013", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "'The plan failed.' -> nominalizado: 'the ___ of the plan'", "options": ["failure", "fail", "failness"], "answer": "failure", "explanation": "fail -> failure." },
    { "id": "t16-014", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "La nominalizacion hace que un texto sea:", "options": ["mas denso y mas formal / academico", "mas coloquial", "siempre mas largo y vago"], "answer": "mas denso y mas formal / academico", "explanation": "Empaqueta ideas en sustantivos." },
    { "id": "t16-015", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "'Prices increased, which worried economists.' -> 'The ___ in prices worried economists.'", "options": ["increase", "increasing", "increasement"], "answer": "increase", "explanation": "increase (verbo) = increase (sustantivo)." },
