    { "id": "t16-052", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'Her career really took off.' Aqui 'take off' significa:", "options": ["despego / triunfo", "abandono el suelo", "imito a alguien"], "answer": "despego / triunfo", "explanation": "Sentido idiomatico de 'take off'." },
    { "id": "t16-053", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "Muchos phrasal verbs son:", "options": ["polisemicos: una forma, varios significados", "siempre literales", "siempre idiomaticos"], "answer": "polisemicos: una forma, varios significados", "explanation": "'take off' tiene 4+ sentidos." },
    { "id": "t16-054", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'He takes after his mother.' 'take after' =", "options": ["se parece a", "persigue a", "cuida de"], "answer": "se parece a", "explanation": "take after = parecerse a un familiar." },
    { "id": "t16-055", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'Please carry on.' 'carry on' =", "options": ["continuar", "transportar", "discutir"], "answer": "continuar", "explanation": "carry on = continue." },
    { "id": "t16-056", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'The deal fell through.' 'fall through' =", "options": ["no llego a realizarse", "se derrumbo fisicamente", "se cayo al suelo"], "answer": "no llego a realizarse", "explanation": "fall through = fracasar (un plan)." },
    { "id": "t16-057", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'I can't make out the sign.' 'make out' =", "options": ["distinguir / entender con dificultad", "inventar", "besarse"], "answer": "distinguir / entender con dificultad", "explanation": "make out = discernir." },
    { "id": "t16-058", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'run into an old friend' =", "options": ["encontrarse por casualidad", "chocar con", "escapar de"], "answer": "encontrarse por casualidad", "explanation": "run into someone = topar con alguien." },
    { "id": "t16-059", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'run into problems' =", "options": ["encontrarse con / tropezar con", "golpear fisicamente", "resolver"], "answer": "encontrarse con / tropezar con", "explanation": "run into problems = topar con dificultades." },
    { "id": "t16-060", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'The meeting was put off.' 'put off' =", "options": ["aplazada", "colocada en el suelo", "desagradable"], "answer": "aplazada", "explanation": "put off (a meeting) = postpone." },
    { "id": "t16-061", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'The smell put me off my food.' 'put off' =", "options": ["me quito las ganas", "lo aplazo", "lo coloco"], "answer": "me quito las ganas", "explanation": "put someone off (something) = repugnar / desanimar." },
    { "id": "t16-062", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "El significado de un phrasal verb idiomatico:", "options": ["no se deduce de sus partes (verbo + particula)", "es exactamente la suma de las partes", "es siempre literal"], "answer": "no se deduce de sus partes (verbo + particula)", "explanation": "Hay que aprenderlo como una unidad." },
    { "id": "t16-063", "subtopic": "phrasal-literal-idiomatico", "type": "mcq", "prompt": "'come across as arrogant' =", "options": ["dar la impresion de ser", "cruzar una calle", "encontrar por casualidad"], "answer": "dar la impresion de ser", "explanation": "come across as = parecer / transmitir." },

    { "id": "t16-064", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'Turn ___.' (la luz) - con un pronombre:", "options": ["turn it off", "turn off it", "off turn it"], "answer": "turn it off", "explanation": "Con pronombre, va en medio." },
    { "id": "t16-065", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "Con un objeto NOMBRE, un phrasal verb separable permite:", "options": ["'turn off the light' O 'turn the light off'", "solo 'turn off the light'", "solo 'turn the light off'"], "answer": "'turn off the light' O 'turn the light off'", "explanation": "Con nombre, ambas posiciones valen." },
    { "id": "t16-066", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "Con un objeto PRONOMBRE, un phrasal verb separable exige:", "options": ["el pronombre en medio ('turn it off')", "el pronombre tras la particula ('turn off it')", "cualquiera"], "answer": "el pronombre en medio ('turn it off')", "explanation": "Nunca 'turn off it'." },
    { "id": "t16-067", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'look after the children' - es 'look after' separable?", "options": ["No, es inseparable ('look after them', no 'look them after')", "Si", "-"], "answer": "No, es inseparable ('look after them', no 'look them after')", "explanation": "Verbo y particula no se separan." },
    { "id": "t16-068", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "Los phrasal verbs de 3 partes (p. ej. 'put up with') son:", "options": ["siempre inseparables ('put up with it')", "separables", "de 2 partes"], "answer": "siempre inseparables ('put up with it')", "explanation": "El objeto va detras de la ultima particula." },
    { "id": "t16-069", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'I can't put up ___ this noise.'", "options": ["with", "-", "up"], "answer": "with", "explanation": "put up with = tolerar." },
    { "id": "t16-070", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'She looked the word ___ in the dictionary.'", "options": ["up", "after", "into"], "answer": "up", "explanation": "look something up = buscarlo (en una lista/diccionario)." },
    { "id": "t16-071", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'He got ___ his illness.' (se recupero - inseparable)", "options": ["over", "up", "off"], "answer": "over", "explanation": "get over something = recuperarse de." },
    { "id": "t16-072", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'They called ___ the wedding.' (la cancelaron)", "options": ["off", "up", "on"], "answer": "off", "explanation": "call something off = cancelar." },
    { "id": "t16-073", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'Call it off' o 'Call off it'?", "options": ["Call it off", "Call off it", "Las dos"], "answer": "Call it off", "explanation": "'call off' es separable: el pronombre va en medio." },
    { "id": "t16-074", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "Los phrasal verbs inseparables mantienen verbo + particula:", "options": ["juntos, delante del objeto", "separados alrededor del objeto", "en cualquier orden"], "answer": "juntos, delante del objeto", "explanation": "'look after them', 'get over it'." },
    { "id": "t16-075", "subtopic": "phrasal-separables", "type": "mcq", "prompt": "'come up with a plan' ('come up with') es:", "options": ["un phrasal verb de 3 partes inseparable", "separable", "literal"], "answer": "un phrasal verb de 3 partes inseparable", "explanation": "come up with something = idear / proponer." },

    { "id": "t16-076", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'put off' (una reunion):", "options": ["postpone", "delay it a bit", "hold off"], "answer": "postpone", "explanation": "put off -> postpone." },
    { "id": "t16-077", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'look into':", "options": ["investigate", "check out", "see about"], "answer": "investigate", "explanation": "look into -> investigate." },
    { "id": "t16-078", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'give up' (un plan):", "options": ["abandon", "quit", "drop"], "answer": "abandon", "explanation": "give up -> abandon." },
    { "id": "t16-079", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'find out':", "options": ["ascertain / discover", "dig up", "suss out"], "answer": "ascertain / discover", "explanation": "find out -> ascertain / discover / establish." },
    { "id": "t16-080", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'set up' (una empresa):", "options": ["establish", "start up", "get going"], "answer": "establish", "explanation": "set up -> establish / found." },
    { "id": "t16-081", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'go up' (los precios):", "options": ["rise / increase", "shoot up", "climb"], "answer": "rise / increase", "explanation": "go up -> rise / increase." },
    { "id": "t16-082", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'cut down on':", "options": ["reduce", "slash", "trim"], "answer": "reduce", "explanation": "cut down on -> reduce." },
    { "id": "t16-083", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Los phrasal verbs suelen ser:", "options": ["mas informales / conversacionales que sus equivalentes latinos", "siempre mas formales", "identicos en registro"], "answer": "mas informales / conversacionales que sus equivalentes latinos", "explanation": "Por eso la escritura formal prefiere el verbo latino." },
    { "id": "t16-084", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "En un ensayo academico preferirias:", "options": ["'The results demonstrate...' antes que 'The results show up...'", "'show up'", "-"], "answer": "'The results demonstrate...' antes que 'The results show up...'", "explanation": "Verbo latino en registro academico." },
    { "id": "t16-085", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'bring about':", "options": ["cause / lead to", "kick off", "spark off"], "answer": "cause / lead to", "explanation": "bring about -> cause / bring about change." },
    { "id": "t16-086", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Equivalente formal de 'point out':", "options": ["indicate / note", "flag up", "bring up"], "answer": "indicate / note", "explanation": "point out -> indicate / note / observe." },
    { "id": "t16-087", "subtopic": "phrasal-registro", "type": "mcq", "prompt": "Algunos phrasal verbs NO tienen equivalente de una sola palabra, p. ej.:", "options": ["'get on with someone', 'put up with'", "'postpone', 'investigate'", "-"], "answer": "'get on with someone', 'put up with'", "explanation": "En esos casos el phrasal es insustituible." },

    { "id": "t16-088", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "Elige la colocacion: 'The country ___ rapid economic growth.'", "options": ["is experiencing / undergoing", "is doing", "is making"], "answer": "is experiencing / undergoing", "explanation": "experience / undergo growth / change." },
    { "id": "t16-089", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'The evidence ___ doubt on the theory.'", "options": ["casts", "throws away", "makes"], "answer": "casts", "explanation": "cast doubt on something." },
    { "id": "t16-090", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'a ___ difference' (muy grande)", "options": ["vast / considerable", "heavy", "narrow"], "answer": "vast / considerable", "explanation": "a vast / considerable / marked difference." },
    { "id": "t16-091", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "Nominaliza: 'The system was implemented, which reduced errors.' -> 'The ___ of the system reduced errors.'", "options": ["implementation", "implementing", "implement"], "answer": "implementation", "explanation": "implement -> implementation." },
    { "id": "t16-092", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'She ___ a promise.' (no la cumplio)", "options": ["broke", "did", "made"], "answer": "broke", "explanation": "break a promise; make a promise; keep a promise." },
    { "id": "t16-093", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "Reescritura formal de 'We need to look into this':", "options": ["We need to investigate this.", "We need to check this out.", "-"], "answer": "We need to investigate this.", "explanation": "look into -> investigate (registro formal)." },
    { "id": "t16-094", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'take it off' o 'take off it': cual es correcta con un pronombre?", "options": ["take it off", "take off it", "las dos"], "answer": "take it off", "explanation": "'take off' es separable: pronombre en medio." },
    { "id": "t16-095", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'I can't ___ his constant complaining.' (tolerar)", "options": ["put up with", "put off", "put down"], "answer": "put up with", "explanation": "put up with = soportar / tolerar." },
    { "id": "t16-096", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'___ a distinction between X and Y'", "options": ["draw / make", "do", "take"], "answer": "draw / make", "explanation": "draw / make a distinction." },
    { "id": "t16-097", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'The plan ___ several stages.' (consta de)", "options": ["involves / comprises", "makes", "does"], "answer": "involves / comprises", "explanation": "involve / comprise / consist of." },
    { "id": "t16-098", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'deeply' colocaciona con:", "options": ["'concerned', 'moved', 'rooted'", "'raining', 'populated'", "'unlikely', 'likely'"], "answer": "'concerned', 'moved', 'rooted'", "explanation": "deeply + emociones / arraigo." },
    { "id": "t16-099", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "'highly' colocaciona con:", "options": ["'unlikely', 'skilled', 'controversial'", "'sorry', 'raining'", "'asleep'"], "answer": "'unlikely', 'skilled', 'controversial'", "explanation": "highly + probabilidad / cualidad valorada." },
    { "id": "t16-100", "subtopic": "contraste-lexico-c2", "type": "mcq", "prompt": "En C2, la lexis precisa significa:", "options": ["elegir la colocacion exacta y el registro adecuado", "usar palabras raras porque si", "preferir siempre los phrasal verbs"], "answer": "elegir la colocacion exacta y el registro adecuado", "explanation": "La adecuacion importa mas que la rareza." }
  ]
}
