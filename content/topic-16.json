    { "id": "t16-017", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "'We reduced costs. This improved profits.' -> 'The ___ in costs improved profits.'", "options": ["reduction", "reducing", "reducement"], "answer": "reduction", "explanation": "reduce -> reduction." },
    { "id": "t16-018", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "La escritura academica favorece la nominalizacion porque:", "options": ["condensa informacion y suena objetiva", "es mas facil de leer en voz alta", "usa mas pronombres"], "answer": "condensa informacion y suena objetiva", "explanation": "Tono impersonal y denso." },
    { "id": "t16-019", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "'They discovered a new gene.' -> 'the ___ of a new gene'", "options": ["discovery", "discover", "discovering"], "answer": "discovery", "explanation": "discover -> discovery." },
    { "id": "t16-020", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "Cual esta mas nominalizada (formal)?", "options": ["The implementation of the policy caused delays.", "When they put the policy in place, things got delayed.", "-"], "answer": "The implementation of the policy caused delays.", "explanation": "'implementation' + sujeto abstracto." },
    { "id": "t16-021", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "'He was reluctant to sign.' -> 'his ___ to sign'", "options": ["reluctance", "reluctant", "reluctancy"], "answer": "reluctance", "explanation": "reluctant -> reluctance." },
    { "id": "t16-022", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "Abusar de la nominalizacion produce:", "options": ["un estilo 'zombie', recargado y abstracto", "prosa clara y directa", "dialogo"], "answer": "un estilo 'zombie', recargado y abstracto", "explanation": "Demasiados sustantivos abstractos cansan al lector." },
    { "id": "t16-023", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "'The committee decided to postpone.' -> 'The committee's ___ to postpone'", "options": ["decision", "deciding", "decisiveness"], "answer": "decision", "explanation": "decide -> decision." },
    { "id": "t16-024", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "La nominalizacion suele combinarse con:", "options": ["la voz pasiva y sujetos abstractos", "imperativos", "exclamaciones"], "answer": "la voz pasiva y sujetos abstractos", "explanation": "'The reduction was achieved...'." },
    { "id": "t16-025", "subtopic": "nominalizacion-estilo", "type": "mcq", "prompt": "Buena practica: usar la nominalizacion", "options": ["de forma deliberada, no por defecto", "en cada frase", "nunca"], "answer": "de forma deliberada, no por defecto", "explanation": "Es una herramienta, no un habito automatico." },

    { "id": "t16-026", "subtopic": "colocaciones-verbo-nombre", "type": "mcq", "prompt": "You ___ a decision.", "options": ["make", "do", "take"], "answer": "make", "explanation": "make a decision." },
