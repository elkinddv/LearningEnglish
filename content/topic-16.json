    { "id": "t16-036", "subtopic": "colocaciones-verbo-nombre", "type": "mcq", "prompt": "'do' vs 'make': you ___ your homework and ___ a mistake.", "options": ["do / make", "make / do", "take / do"], "answer": "do / make", "explanation": "do homework; make a mistake." },
