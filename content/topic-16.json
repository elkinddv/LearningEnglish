    { "id": "t16-049", "subtopic": "colocaciones-intensificadoras", "type": "mcq", "prompt": "Las colocaciones intensificadoras son:", "options": ["bastante fijas - hay que aprender que adverbio va con que adjetivo", "libremente intercambiables", "siempre con 'very'"], "answer": "bastante fijas - hay que aprender que adverbio va con que adjetivo", "explanation": "'highly unlikely' si; 'deeply unlikely' no." },
    { "id": "t16-050", "subtopic": "colocaciones-intensificadoras", "type": "mcq", "prompt": "'It's ___ raining' (con fuerza) - el adverbio es:", "options": ["heavily", "strongly", "highly"], "answer": "heavily", "explanation": "rain heavily (o 'It's pouring')." },

