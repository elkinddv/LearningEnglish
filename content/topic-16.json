    { "id": "t16-032", "subtopic": "colocaciones-verbo-nombre", "type": "mcq", "prompt": "Supply must ___ demand.", "options": ["meet", "reach", "take"], "answer": "meet", "explanation": "meet demand / a target / a deadline." },
