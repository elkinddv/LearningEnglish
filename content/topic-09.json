    { "id": "t9-049", "subtopic": "gerundio-usos", "type": "mcq", "prompt": "It's no use ___ about it now.", "options": ["worrying", "to worry", "worry"], "answer": "worrying", "explanation": "It's no use + -ing." },
    { "id": "t9-050", "subtopic": "gerundio-usos", "type": "mcq", "prompt": "Verbos que suelen ir con -ing:", "options": ["enjoy, avoid, mind, suggest, finish, deny, imagine, risk, practise", "want, hope, decide, offer", "-"], "answer": "enjoy, avoid, mind, suggest, finish, deny, imagine, risk, practise", "explanation": "Grupo tipico de verbos + gerundio." },

    { "id": "t9-051", "subtopic": "infinitivo-usos", "type": "mcq", "prompt": "I want ___ home.", "options": ["to go", "going", "go"], "answer": "to go", "explanation": "want + to + infinitivo." },
