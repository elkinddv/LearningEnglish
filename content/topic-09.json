    { "id": "t9-042", "subtopic": "gerundio-usos", "type": "mcq", "prompt": "He avoided ___ the question.", "options": ["answering", "to answer", "answer"], "answer": "answering", "explanation": "avoid + -ing." },
    { "id": "t9-043", "subtopic": "gerundio-usos", "type": "mcq", "prompt": "They kept ___ even though they were tired.", "options": ["walking", "to walk", "walk"], "answer": "walking", "explanation": "keep + -ing." },
